# ── Dockerfile para el Servidor de Tracking (MLflow) ──
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=5000

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Instalar MLflow y soporte de almacenamiento de artefactos (boto3 para AWS S3)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir mlflow boto3

# Copiar base de datos y artefactos locales de MLflow para visualización inmediata
RUN mkdir -p /app/mlruns
COPY mlflow.db /app/mlflow.db
COPY mlruns/ /app/mlruns/

ENV MLFLOW_DISABLE_TELEMETRY=true
EXPOSE 5000

# Chequeo de salud del servicio MLflow
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

# Iniciar servidor centralizado de MLflow (1 worker para bajo consumo de RAM en Azure Container Apps)
CMD ["mlflow", "server", "--backend-store-uri", "sqlite:////app/mlflow.db", "--default-artifact-root", "/app/mlruns", "--host", "0.0.0.0", "--port", "5000", "--workers", "1", "--allowed-hosts", "*"]
