# ==============================================================================
# VARIABLES DE ENTORNO - PROYECTO MONITOR DE SUEÑO (GRUPO 25)
# ==============================================================================

# Token de autenticación de Hugging Face (con permisos de Write/Read)
# Obtenlo en: https://huggingface.co/settings/tokens
HUGGING_FACE_API_KEY=hf_your_token_here

# Repositorios oficiales de almacenamiento en Hugging Face Hub
HF_DATA_REPO=maia-grupo25/sleep-edfx-data
HF_MODEL_REPO=maia-grupo25/sleep-edfx-models
HF_REPO_TYPE=dataset

# Configuración de MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000

# Configuración de Inferencia y Servidores
API_PORT=8000
API_URL=http://localhost:8000
